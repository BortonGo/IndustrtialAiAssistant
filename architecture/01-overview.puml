@startuml
!include theme.iuml
title Local Assistant — локальная архитектура с PostgreSQL
left to right direction
actor Пользователь as User
package "Qt 5.7 / C++" {
  component "Виджеты и модели списков" as UI
  component ChatManager as Chat
  component AssistantService as Service
  component "DocumentManager × 2\nдокументы на экране / документы задачи" as Docs
  component "InMemoryVectorStore\nиндекс задачи / выбранного чата" as Index
  component "DocumentContext\nимя файла / таблицы / примечания" as DocumentContext
  component "StorageClient\nасинхронный JSON / stdio" as Storage
  component "HTTP-клиенты моделей" as Models
  component "ContextBuilder\nистория + источники + бюджет токенов" as Context
  component "context_selection\nкатегория вопроса + отбор данных" as Selection
  component "system_status_policy\nCPU/RAM только по запросу" as StatusPolicy
}
package "Локальные процессы" {
  component "storage_tools/server.py\nRepository / psycopg" as Worker
  database "PostgreSQL 17\n127.0.0.1:55432" as DB
  component "read_document.py\nPoppler / DOCX / фотографии" as Extract
  component "llama-server × 2\nQwen3-VL / EmbeddingGemma" as Servers
  component "MCP server\nCPU / RAM" as MCP
}
folder "storage-data/images\nпостоянные изображения" as Images #24262B
User --> UI
UI --> Chat
Chat --> Service
Chat --> Storage
Service --> Storage
Service --> Docs
Service --> Index
Service --> DocumentContext : связанные источники из блоков
Service --> Models
Service --> MCP
Docs --> Extract
Extract --> Servers : распознавание
Models --> Servers : HTTP
Storage --> Worker : запросы с id / ответы
Worker --> DB : SQL / транзакции
Worker --> Images : сохранение / восстановление / очистка после удаления
Models --> Context : подготовка запроса
Models --> Selection : схема JSON / проверка ID
Models --> StatusPolicy : история и ответ
Context --> Selection : текстовый запрос отбора
Context --> Servers : /apply-template и /tokenize
legend bottom
  Чаты и документы сохраняются в PostgreSQL. История запроса принадлежит исходному чату.
  Переключение интерфейса не меняет данные выполняемой задачи. Вычисления последовательные.
  Ни UI, ни языковая модель не выполняют SQL.
  Удаление чата каскадно очищает БД; общие изображения сохраняются.
endlegend
@enduml
