@startuml
!include theme.iuml
title Local Assistant — локальная архитектура с PostgreSQL
left to right direction
actor Пользователь as User
package "Qt 5.7 / C++" {
  component "Виджеты и модели списков" as UI
  component ChatManager as Chat
  component AssistantService as Service
  component "DocumentManager\nдокументы текущего чата" as Docs
  component "InMemoryVectorStore\nиндекс текущего чата" as Index
  component "StorageClient\nасинхронный JSON / stdio" as Storage
  component "HTTP-клиенты моделей" as Models
  component "Следующий блок: ContextBuilder\nистория + источники + бюджет токенов" as Context #493823
}
package "Локальные процессы" {
  component "storage_tools/server.py\nRepository / psycopg" as Worker
  database "PostgreSQL 17\n127.0.0.1:55432" as DB
  component "read_document.py\nPoppler / DOCX / фотографии" as Extract
  component "llama-server × 2\nQwen3-VL / EmbeddingGemma" as Servers
  component "MCP server\nCPU / RAM" as MCP
}
folder "storage-data/images\nпостоянные изображения" as Images
User --> UI
UI --> Chat
Chat --> Service
Chat --> Storage
Service --> Storage
Service --> Docs
Service --> Index
Service --> Models
Service --> MCP
Docs --> Extract
Extract --> Servers : распознавание
Models --> Servers : HTTP
Storage --> Worker : запросы с id / ответы
Worker --> DB : SQL / транзакции
Worker --> Images : сохранение / восстановление
Service ..> Context
legend bottom
  Чаты и документы сохраняются в PostgreSQL. Индекс в RAM — только для текущего чата.
  Коричневый блок — следующий этап, ещё не включён в запрос LLM.
  Ни UI, ни языковая модель не выполняют SQL.
endlegend
@enduml
