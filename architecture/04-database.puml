@startuml
!include theme.iuml
title PostgreSQL — реализованная схема (миграции 001–005)
hide circle
skinparam linetype ortho
entity chats {
 * id : uuid <<PK>>
 title : text
 created_at / updated_at : timestamptz
}
entity messages {
 * id : uuid <<PK>>
 * chat_id : uuid <<FK>>
 position : bigint <<IDENTITY>>
 role / status / error : text
 text : text
 reply_to : uuid <<FK>>
 context_snapshot : text
 created_at : timestamptz
}
entity message_attachments {
 * message_id : uuid <<PK, FK>>
 * position : integer <<PK>>
 file_name / source_path : text
 document_id : uuid <<FK, nullable>>
 preview_image : text
}
entity documents {
 * id : uuid <<PK>>
 * chat_id : uuid <<FK>>
 source_path / source_key : text
 content_sha256 : text
 extracted_text : text
 warnings : jsonb
 pipeline_version : text
 pending_images : integer
 UNIQUE(chat_id, source_key)
}
entity document_blocks {
 * document_id : uuid <<PK, FK>>
 * position : integer <<PK>>
 kind : text
 payload : jsonb
}
entity chunks {
 * document_id : uuid <<PK, FK>>
 * position : integer <<PK>>
 text : text
 start_offset : integer <<UTF-16>>
 metadata : jsonb
 profile_id : text <<FK>>
 embedding : double precision[]
}
entity embedding_profiles {
 * id : text <<PK>>
 model_sha256 : text
 preprocessing_version : text
 dimension : integer
}
entity schema_migrations {
 * version : integer <<PK>>
 checksum : text
 applied_at : timestamptz
}
entity app_settings {
 * key : text <<PK>>
 value : text
}
entity document_imports {
 * id : uuid <<PK>>
 * chat_id : uuid <<FK>>
 document_id : uuid
 source_path / source_key / source_sha256 : text
 profile_id : text <<FK>>
 status / progress / error : text
 checkpoint : jsonb
 native_done : boolean
}
entity document_import_chunks {
 * import_id : uuid <<PK, FK>>
 * position : integer <<PK>>
 payload : jsonb
}
chats ||--o{ messages
chats ||--o{ documents
messages ||--o{ message_attachments
documents |o--o{ message_attachments
messages |o--o| messages
documents ||--o{ document_blocks
documents ||--o{ chunks
embedding_profiles ||--o{ chunks
chats ||--o{ document_imports
embedding_profiles ||--o{ document_imports
document_imports ||--o{ document_import_chunks
note bottom of messages
 Источники вопроса сохраняются снимком.
 Ответ связан с исходным вопросом.
 Ответ и вопрос принадлежат одному чату.
 UNIQUE(reply_to) исключает второй ответ на тот же запрос.
 Ответ: complete или failed (сохранённый фрагмент при обрыве).
end note
note bottom of chunks
 Каждый этап публикуется транзакционно с полным индексом своей версии.
 pending_images > 0: доступен текст, изображения ещё неизвестны.
 Поиск выполняется в RAM в пределах одного чата и профиля.
end note
@enduml
