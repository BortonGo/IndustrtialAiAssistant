@startuml
!include theme.iuml
title PostgreSQL — реализованная схема первой версии
hide circle
skinparam linetype ortho
entity chats {
 * id : uuid <<PK>>
 title : text
 created_at / updated_at : timestamptz
}
entity messages {
 * id : uuid <<PK>>
 * chat_id : uuid <<FK>>
 position : bigint <<IDENTITY>>
 role / status / error : text
 text : text
 reply_to : uuid <<FK>>
 context_snapshot : text
 created_at : timestamptz
}
entity documents {
 * id : uuid <<PK>>
 * chat_id : uuid <<FK>>
 source_path / source_key : text
 content_sha256 : text
 extracted_text : text
 warnings : jsonb
 pipeline_version : text
 UNIQUE(chat_id, source_key)
}
entity document_blocks {
 * document_id : uuid <<PK, FK>>
 * position : integer <<PK>>
 kind : text
 payload : jsonb
}
entity chunks {
 * document_id : uuid <<PK, FK>>
 * position : integer <<PK>>
 text : text
 start_offset : integer <<UTF-16>>
 metadata : jsonb
 profile_id : text <<FK>>
 embedding : double precision[]
}
entity embedding_profiles {
 * id : text <<PK>>
 model_sha256 : text
 preprocessing_version : text
 dimension : integer
}
entity schema_migrations {
 * version : integer <<PK>>
 checksum : text
 applied_at : timestamptz
}
entity app_settings {
 * key : text <<PK>>
 value : text
}
chats ||--o{ messages
chats ||--o{ documents
messages |o--o| messages
documents ||--o{ document_blocks
documents ||--o{ chunks
embedding_profiles ||--o{ chunks
note bottom of messages
 Источники вопроса сохраняются снимком.
 Ответ связан с исходным вопросом.
 Ответ и вопрос принадлежат одному чату.
 UNIQUE(reply_to) исключает второй ответ на тот же запрос.
end note
note bottom of chunks
 Только полный индекс публикуется транзакционно.
 Поиск выполняется в RAM в пределах одного чата и профиля.
end note
@enduml
